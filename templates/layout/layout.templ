package layout

templ Base(active string) {
	<!DOCTYPE html>
	<html lang="he" dir="rtl">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>חברת הביטוח - ניהול פוליסות</title>
			<script>
				(function () {
					var company = localStorage.getItem("insurance-company") || "default";
					var mode = localStorage.getItem("insurance-theme") || "light";
					document.documentElement.setAttribute("data-company", company);
					document.documentElement.setAttribute("data-theme", mode);
				})();
			</script>
			<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet"/>
			<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"/>
			<link href="/static/css/app.css" rel="stylesheet"/>
			<link href="/static/css/themes.css" rel="stylesheet"/>
			<script src="https://unpkg.com/htmx.org@2.0.4"></script>
			<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.3/dist/cdn.min.js"></script>
			<script src="/static/js/app.js"></script>
			<script src="/static/js/theme.js"></script>
		</head>
		<body>
			<div class="app-shell">
				@Sidebar(active)
				<main class="app-main">
					<div id="main-content">
						{ children... }
					</div>
				</main>
			</div>
		</body>
	</html>
}

templ Sidebar(active string) {
	<nav class="app-sidebar">
		<div class="sidebar-workspace">
			<div class="workspace-icon" id="workspace-icon">ב</div>
			<div class="workspace-name" id="workspace-name">חברת הביטוח</div>
		</div>
		<div class="sidebar-search">
			<div class="search-box" x-data="{ open: false }" x-on:click.outside="open = false">
				<i class="bi bi-search search-icon"></i>
				<input
					type="text"
					name="q"
					class="form-control search-input"
					placeholder="חיפוש לקוח או מספר פוליסה..."
					autocomplete="off"
					hx-get="/search"
					hx-trigger="keyup changed delay:300ms, search"
					hx-target="#search-results"
					x-on:focus="open = true"
					x-on:keyup="open = true"
				/>
				<div id="search-results" x-show="open" style="display:none"></div>
			</div>
		</div>
		<div class="sidebar-section-title">תפריט</div>
		<ul class="sidebar-nav">
			@navItem("/", "bi-grid-1x2-fill", "לוח בקרה", active == "dashboard")
			@navSection("לקוחות", "bi-people-fill", "/clients", active == "clients", "לקוח")
			@navSection("פוליסות", "bi-file-earmark-text-fill", "/policies", active == "policies", "פוליסה")
			@navSection("תביעות", "bi-exclamation-diamond-fill", "/claims", active == "claims", "תביעה")
			@navSection("תשלומים", "bi-cash-coin", "/payments", active == "payments", "תשלום")
			@navSection("יומן הקלטות", "bi-mic-fill", "/recordings", active == "recordings", "שיחה מוקלטת")
			@navItem("/chat", "bi-chat-dots-fill", "צ'אט", active == "chat")
		</ul>
		<div class="sidebar-footer">
			<div class="sidebar-section-title">ערכת נושא</div>
			<select id="company-switcher" class="form-select form-select-sm mb-2">
				<option value="default">חברת הביטוח (ברירת מחדל)</option>
				<option value="phoenix">הפניקס</option>
				<option value="hapoel">הפול חברת ביטוח</option>
				<option value="agri">ביטוח חקלאי</option>
				<option value="shmeret">שמרת ביטוח</option>
			</select>
			<button id="theme-toggle" type="button" class="btn btn-sm btn-outline-light w-100">
				<i class="bi bi-moon-stars-fill" id="theme-toggle-icon"></i>
				<span id="theme-toggle-label">מצב כהה</span>
			</button>
		</div>
	</nav>
}

templ navItem(href, icon, label string, isActive bool) {
	if isActive {
		<li class="sidebar-item active">
			<a href={ templ.URL(href) } hx-get={ href } hx-target="#main-content" hx-push-url="true">
				<i class={ "bi", icon }></i>
				<span>{ label }</span>
			</a>
		</li>
	} else {
		<li class="sidebar-item">
			<a href={ templ.URL(href) } hx-get={ href } hx-target="#main-content" hx-push-url="true">
				<i class={ "bi", icon }></i>
				<span>{ label }</span>
			</a>
		</li>
	}
}

templ navSection(label, icon, href string, isActive bool, singular string) {
	<li class={ "sidebar-item sidebar-section", templ.KV("active", isActive) } x-data="{ open: false }">
		<a href={ templ.URL(href) } hx-get={ href } hx-target="#main-content" hx-push-url="true" class="d-flex align-items-center">
			<i class={ "bi", icon }></i>
			<span class="flex-grow-1">{ label }</span>
			<i class="bi bi-chevron-left submenu-caret" x-on:click.prevent.stop="open = !open" x-bind:class="open ? 'rotated' : ''"></i>
		</a>
		<ul class="sidebar-submenu" x-show="open" x-transition style="display:none">
			<li>
				<a href={ templ.URL(href) } hx-get={ href } hx-target="#main-content" hx-push-url="true">
					<i class="bi bi-list-ul"></i> כל ה{ label }
				</a>
			</li>
			<li>
				<a href={ templ.URL(href + "?new=1") } hx-get={ href + "?new=1" } hx-target="#main-content" hx-push-url="true">
					<i class="bi bi-plus-lg"></i> { singular } חדש
				</a>
			</li>
		</ul>
	</li>
}

templ PageHeader(title string, subtitle string) {
	<div class="page-header">
		<div>
			<h1>{ title }</h1>
			if subtitle != "" {
				<p class="text-muted mb-0">{ subtitle }</p>
			}
		</div>
	</div>
}
