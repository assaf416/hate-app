package layout

import (
	"net/url"
	"strconv"
)

// PageInfo carries everything a list page needs to render pagination,
// sorting, and filtering controls, and to build URLs that preserve all of
// that state across navigation.
type PageInfo struct {
	Page       int
	PageSize   int
	Total      int
	TotalPages int
	BasePath   string

	Sort   string
	Dir    string // "asc" | "desc"
	Q      string
	Status string
}

func (p PageInfo) values() url.Values {
	v := url.Values{}
	if p.Sort != "" {
		v.Set("sort", p.Sort)
	}
	if p.Dir != "" {
		v.Set("dir", p.Dir)
	}
	if p.Q != "" {
		v.Set("q", p.Q)
	}
	if p.Status != "" {
		v.Set("status", p.Status)
	}
	return v
}

// PageURL builds a link to the given page number, preserving the current
// sort and filter state.
func (p PageInfo) PageURL(page int) string {
	v := p.values()
	v.Set("page", strconv.Itoa(page))
	return p.BasePath + "?" + v.Encode()
}

// IsSort reports whether the list is currently sorted by the given column.
func (p PageInfo) IsSort(column string) bool {
	return p.Sort == column
}

// SortURL builds a link that sorts by the given column: toggling direction
// if already sorted by it, otherwise sorting ascending. Preserves the
// current filter state and resets to page 1.
func (p PageInfo) SortURL(column string) string {
	v := p.values()
	dir := "asc"
	if p.IsSort(column) && p.Dir != "desc" {
		dir = "desc"
	}
	v.Set("sort", column)
	v.Set("dir", dir)
	v.Set("page", "1")
	return p.BasePath + "?" + v.Encode()
}

// SortIcon returns the Bootstrap Icons class for the sort indicator shown
// next to a column header.
func (p PageInfo) SortIcon(column string) string {
	if !p.IsSort(column) {
		return "bi-arrow-down-up sort-icon-inactive"
	}
	if p.Dir == "desc" {
		return "bi-sort-down-alt"
	}
	return "bi-sort-up"
}

templ Base(active string) {
	<!DOCTYPE html>
	<html lang="he" dir="rtl">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>חברת הביטוח - ניהול פוליסות</title>
			<script>
				(function () {
					var company = localStorage.getItem("insurance-company") || "default";
					var mode = localStorage.getItem("insurance-theme") || "light";
					document.documentElement.setAttribute("data-company", company);
					document.documentElement.setAttribute("data-theme", mode);
				})();
			</script>
			<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet"/>
			<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"/>
			<link href="/static/css/app.css" rel="stylesheet"/>
			<link href="/static/css/themes.css" rel="stylesheet"/>
			<script src="https://unpkg.com/htmx.org@2.0.4"></script>
			<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.3/dist/cdn.min.js"></script>
			<script src="/static/js/app.js"></script>
			<script src="/static/js/theme.js"></script>
		</head>
		<body>
			<div class="app-shell">
				@Sidebar(active)
				<main class="app-main">
					<div id="main-content">
						{ children... }
					</div>
				</main>
			</div>
		</body>
	</html>
}

templ Sidebar(active string) {
	<nav class="app-sidebar">
		<div class="sidebar-workspace">
			<div class="workspace-icon" id="workspace-icon">ב</div>
			<div class="workspace-name" id="workspace-name">חברת הביטוח</div>
		</div>
		<div class="sidebar-search">
			<div class="search-box" x-data="{ open: false }" x-on:click.outside="open = false">
				<i class="bi bi-search search-icon"></i>
				<input
					type="text"
					name="q"
					class="form-control search-input"
					placeholder="חיפוש לקוח או מספר פוליסה..."
					autocomplete="off"
					hx-get="/search"
					hx-trigger="keyup changed delay:300ms, search"
					hx-target="#search-results"
					x-on:focus="open = true"
					x-on:keyup="open = true"
				/>
				<div id="search-results" x-show="open" style="display:none"></div>
			</div>
		</div>
		<div class="sidebar-section-title">תפריט</div>
		<ul class="sidebar-nav">
			@navItem("/", "bi-grid-1x2-fill", "לוח בקרה", active == "dashboard")
			@navSection("לקוחות", "bi-people-fill", "/clients", active == "clients", "לקוח")
			@navSection("פוליסות", "bi-file-earmark-text-fill", "/policies", active == "policies", "פוליסה")
			@navSection("תביעות", "bi-exclamation-diamond-fill", "/claims", active == "claims", "תביעה")
			@navSection("תשלומים", "bi-cash-coin", "/payments", active == "payments", "תשלום")
			@navSection("יומן הקלטות", "bi-mic-fill", "/recordings", active == "recordings", "שיחה מוקלטת")
			@navItem("/chat", "bi-chat-dots-fill", "צ'אט", active == "chat")
		</ul>
		<div class="sidebar-footer">
			<div class="sidebar-section-title">ערכת נושא</div>
			<select id="company-switcher" class="form-select form-select-sm mb-2">
				<option value="default">חברת הביטוח (ברירת מחדל)</option>
				<option value="phoenix">הפניקס</option>
				<option value="hapoel">הפול חברת ביטוח</option>
				<option value="agri">ביטוח חקלאי</option>
				<option value="shmeret">שמרת ביטוח</option>
			</select>
			<button id="theme-toggle" type="button" class="btn btn-sm btn-outline-light w-100">
				<i class="bi bi-moon-stars-fill" id="theme-toggle-icon"></i>
				<span id="theme-toggle-label">מצב כהה</span>
			</button>
		</div>
	</nav>
}

templ navItem(href, icon, label string, isActive bool) {
	if isActive {
		<li class="sidebar-item active">
			<a href={ templ.URL(href) } hx-get={ href } hx-target="#main-content" hx-push-url="true">
				<i class={ "bi", icon }></i>
				<span>{ label }</span>
			</a>
		</li>
	} else {
		<li class="sidebar-item">
			<a href={ templ.URL(href) } hx-get={ href } hx-target="#main-content" hx-push-url="true">
				<i class={ "bi", icon }></i>
				<span>{ label }</span>
			</a>
		</li>
	}
}

templ navSection(label, icon, href string, isActive bool, singular string) {
	<li class={ "sidebar-item sidebar-section", templ.KV("active", isActive) } x-data="{ open: false }">
		<a href={ templ.URL(href) } hx-get={ href } hx-target="#main-content" hx-push-url="true" class="d-flex align-items-center">
			<i class={ "bi", icon }></i>
			<span class="flex-grow-1">{ label }</span>
			<i class="bi bi-chevron-left submenu-caret" x-on:click.prevent.stop="open = !open" x-bind:class="open ? 'rotated' : ''"></i>
		</a>
		<ul class="sidebar-submenu" x-show="open" x-transition style="display:none">
			<li>
				<a href={ templ.URL(href) } hx-get={ href } hx-target="#main-content" hx-push-url="true">
					<i class="bi bi-list-ul"></i> כל ה{ label }
				</a>
			</li>
			<li>
				<a href={ templ.URL(href + "?new=1") } hx-get={ href + "?new=1" } hx-target="#main-content" hx-push-url="true">
					<i class="bi bi-plus-lg"></i> { singular } חדש
				</a>
			</li>
		</ul>
	</li>
}

templ PageHeader(title string, subtitle string) {
	<div class="page-header">
		<div>
			<h1>{ title }</h1>
			if subtitle != "" {
				<p class="text-muted mb-0">{ subtitle }</p>
			}
		</div>
	</div>
}

templ Pagination(info PageInfo) {
	if info.TotalPages > 1 {
		<div class="pagination-bar">
			<span class="pagination-summary">
				{ strconv.Itoa(info.Total) } תוצאות · עמוד { strconv.Itoa(info.Page) } מתוך { strconv.Itoa(info.TotalPages) }
			</span>
			<div class="btn-group">
				@pageLink(info, 1, "bi-chevron-double-right", info.Page <= 1)
				@pageLink(info, info.Page-1, "bi-chevron-right", info.Page <= 1)
				@pageLink(info, info.Page+1, "bi-chevron-left", info.Page >= info.TotalPages)
				@pageLink(info, info.TotalPages, "bi-chevron-double-left", info.Page >= info.TotalPages)
			</div>
		</div>
	}
}

templ pageLink(info PageInfo, target int, icon string, disabled bool) {
	if disabled {
		<button type="button" class="btn btn-sm btn-outline-secondary" disabled>
			<i class={ "bi", icon }></i>
		</button>
	} else {
		<a
			class="btn btn-sm btn-outline-secondary"
			href={ templ.URL(info.PageURL(target)) }
			hx-get={ info.PageURL(target) }
			hx-target="#main-content"
			hx-push-url="true"
		>
			<i class={ "bi", icon }></i>
		</a>
	}
}

// SortableHeader renders a <th> whose label is a link that sorts the list
// by the given column, toggling direction on repeat clicks.
templ SortableHeader(info PageInfo, column, label string) {
	<th>
		<a
			class="sortable-header"
			href={ templ.URL(info.SortURL(column)) }
			hx-get={ info.SortURL(column) }
			hx-target="#main-content"
			hx-push-url="true"
		>
			{ label }
			<i class={ "bi", info.SortIcon(column) }></i>
		</a>
	</th>
}

// FilterBar renders a free-text search box and, optionally, a status
// dropdown, meant to sit in the same row as a list page's "new" button.
// Both inputs submit together and preserve the current sort/page state via
// hidden fields; changing either resets the list to page 1.
templ FilterBar(info PageInfo, statusOptions []string, statusLabel string) {
	<form class="filter-bar" hx-get={ info.BasePath } hx-target="#main-content" hx-push-url="true">
		if info.Sort != "" {
			<input type="hidden" name="sort" value={ info.Sort }/>
		}
		if info.Dir != "" {
			<input type="hidden" name="dir" value={ info.Dir }/>
		}
		<input
			type="search"
			name="q"
			class="form-control form-control-sm"
			placeholder="חיפוש חופשי..."
			value={ info.Q }
			autocomplete="off"
			hx-get={ info.BasePath }
			hx-trigger="keyup changed delay:400ms, search"
			hx-target="#main-content"
			hx-push-url="true"
			hx-include="closest form"
		/>
		if len(statusOptions) > 0 {
			<select
				name="status"
				class="form-select form-select-sm"
				hx-get={ info.BasePath }
				hx-trigger="change"
				hx-target="#main-content"
				hx-push-url="true"
				hx-include="closest form"
			>
				<option value="">{ statusLabel }: הכל</option>
				for _, s := range statusOptions {
					if info.Status == s {
						<option value={ s } selected>{ s }</option>
					} else {
						<option value={ s }>{ s }</option>
					}
				}
			</select>
		}
	</form>
}
